{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run tmodel *)",
      "Bash(scripts/check.sh *)",
      "Bash(scripts/dev.sh *)",
      "Bash(scripts/parity.sh *)",
      "Bash(node scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$f\" in *.py) cd \"${CLAUDE_PROJECT_DIR:-.}\" && uv run --quiet ruff check --quiet --fix --select I \"$f\" && uv run --quiet ruff format --quiet \"$f\";; esac 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "ruff format"
          }
        ]
      }
    ]
  }
}
